// global — rounded corners and clip for all windows
window-rule {
    geometry-corner-radius 7
    clip-to-geometry true
}

// steam — open non-main windows floating
window-rule {
    match app-id="steam"
    exclude title=r"^[Ss]team$"
    open-floating true
}

// steam — notification toasts go bottom-right, unfocused
window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}


layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

// disable blur behind noctalia bar panel
layer-rule {
    match namespace="^noctalia-.*$"
    background-effect {
        blur false
    }
}