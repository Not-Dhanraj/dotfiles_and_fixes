// ViewSonic - portrait-capable, center/left
output "DP-2" {
    mode "1920x1080@59.934"
    transform "90"
    position x=840 y=0
}

// AU Optronics - laptop panel, right side
output "eDP-2" {
    position x=1920 y=0

    variable-refresh-rate
}

output "HDMI-A-1" {
    mode "1920x1080@165.002"

    scale 1.0

    transform "normal"
    position x=3840 y=0
}
