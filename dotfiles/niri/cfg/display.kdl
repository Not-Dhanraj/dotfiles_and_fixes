// ViewSonic - portrait, left side
output "DP-2" {
    mode "1920x1080@59.934"
    transform "90"
    position x=0 y=0
}

// AU Optronics - laptop panel, center
output "eDP-1" {
    position x=1080 y=0

    variable-refresh-rate
}

output "HDMI-A-1" {
    mode "1920x1080@165.002"

    scale 1.0

    transform "normal"
    position x=3000 y=0
}
