// ViewSonic TD1655 — portrait-capable, center/left
output "DP-2" {
    mode "1920x1080@59.934"
    // transform "90"
    position x=0 y=0
}

// AU Optronics — laptop panel, right side
output "eDP-2" {
    variable-refresh-rate
    position x=1920 y=0
}
