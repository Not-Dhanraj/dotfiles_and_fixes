layout {

    focus-ring {
        active-color   "#c0c4e7"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c0c4e7"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c0c4e7"
        inactive-color "#3c415d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c0c4e780"
    }
}

recent-windows {
    highlight {
        active-color "#c0c4e7"
        urgent-color "#ffb4ab"
    }
}
