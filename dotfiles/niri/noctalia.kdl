layout {

    focus-ring {
        active-color   "#80d4d5"
        inactive-color "#0e1514"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#80d4d5"
        inactive-color "#0e1514"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#80d4d5"
        inactive-color "#004f50"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#80d4d580"
    }
}

recent-windows {
    highlight {
        active-color "#80d4d5"
        urgent-color "#ffb4ab"
    }
}
